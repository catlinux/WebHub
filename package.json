{
  "name": "webhub",
  "version": "0.5.1",
  "description": "Directorio personal de enlaces agrupados por familias, con panel de administración.",
  "author": "CatLinux",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "start": "node --disable-warning=ExperimentalWarning src/server/main.ts",
    "dev": "node scripts/build.ts && node --disable-warning=ExperimentalWarning --watch src/server/main.ts",
    "pin": "node --disable-warning=ExperimentalWarning src/server/cli-pin.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "5.9"
  }
}
