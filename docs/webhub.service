# /etc/systemd/system/webhub.service
[Unit]
Description=WebHub - directorio personal de enlaces
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=webhub
Group=webhub
WorkingDirectory=/opt/webhub
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/server/main.ts
Environment=NODE_ENV=production
Environment=WEBHUB_HOST=127.0.0.1
Environment=WEBHUB_PORT=3000
Environment=WEBHUB_DATA_DIR=/var/lib/webhub
Environment=WEBHUB_TRUST_PROXY=1
Environment=WEBHUB_PUBLIC_ORIGIN=https://webhub.ejemplo.com
Restart=on-failure
RestartSec=3

# Endurecimiento
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/webhub
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
